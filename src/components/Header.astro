---
import { SITE } from "../site";
import { NAV_LINKS, normalizePathname, isNavActive } from "../lib/nav";

const currentPath = normalizePathname(Astro.url.pathname);
const isHome = currentPath === "/";
const positionClass = isHome ? "fixed top-0 left-0 right-0" : "sticky top-0";

function navClass(to: string, end?: boolean) {
  const active = isNavActive(currentPath, to, end);
  const base =
    "nav-desktop-link focus-ring cursor-pointer whitespace-nowrap rounded-md px-3 py-2 text-sm font-medium transition-colors duration-200";
  if (active) return `${base} text-mb-accent`;
  if (isHome) return `${base}`;
  return `${base} text-mb-text-muted hover:text-mb-accent`;
}
---
<header
  id="site-header"
  data-home={isHome ? "true" : "false"}
  data-hero-top={isHome ? "true" : undefined}
  aria-label={SITE.name}
  class:list={[
    positionClass,
    "site-header z-50 transition-all duration-300",
    isHome
      ? "header-theme-hero border-b border-transparent bg-transparent"
      : "border-b border-mb-accent/20 bg-mb-surface/98 backdrop-blur-md",
  ]}
>
  <div class="mx-auto flex max-w-6xl items-center gap-3 px-4 py-3 sm:gap-5 sm:px-6">
    <a
      href="/"
      class="mb-brand-row focus-ring flex shrink-0 cursor-pointer items-center gap-2.5 rounded-lg p-1 outline-offset-2 transition-opacity duration-200 hover:opacity-85"
    >
      <img
        src={SITE.logoSrc}
        alt=""
        width={36}
        height={36}
        class="h-9 w-9 rounded-lg object-cover ring-1 ring-white/15"
      />
      <span
        class:list={[
          "mb-brand-text font-sans text-sm font-semibold tracking-tight transition-colors duration-200",
          !isHome && "text-mb-text-on-dark",
        ]}
      >
        {SITE.name}
      </span>
    </a>

    <div
      class="mb-header-divider mx-1 hidden h-5 w-px shrink-0 bg-white/10 lg:block"
      aria-hidden
    />

    <nav
      class="hidden flex-1 items-center justify-center gap-0.5 lg:flex"
      aria-label="Main"
    >
      {
        NAV_LINKS.map(({ to, end, label }) => (
          <a
           data-astro-prefetch
            href={to}
            class={navClass(to, end)}
            {...(isNavActive(currentPath, to, end)
              ? { "aria-current": "page" as const }
              : {})}
          >
            {label}
          </a>
        ))
      }
    </nav>

    <div class="flex-1 lg:flex-none" aria-hidden />

    <div
      class="mb-social-wrap hidden items-center gap-0.5 border-r border-white/10 pr-4 sm:flex"
    >
      <a
        href={SITE.social.instagram}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Instagram"
        class="focus-ring cursor-pointer rounded-lg p-2 text-mb-text-muted transition-colors duration-200 hover:text-mb-accent"
      >
        <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z" />
        </svg>
      </a>
      <a
        href={SITE.social.facebook}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Facebook"
        class="focus-ring cursor-pointer rounded-lg p-2 text-mb-text-muted transition-colors duration-200 hover:text-mb-accent"
      >
        <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M24 12.073C24 5.405 18.627 0 12 0S0 5.405 0 12.073C0 18.1 4.388 23.094 10.125 24v-8.437H7.078v-3.473h3.047V9.428c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.473h-2.796v8.413C19.612 23.027 24 18.034 24 12.073z" />
        </svg>
      </a>
      <a
        href={SITE.social.youtube}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="YouTube"
        class="focus-ring cursor-pointer rounded-lg p-2 text-mb-text-muted transition-colors duration-200 hover:text-mb-accent"
      >
        <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" />
        </svg>
      </a>
    </div>

    <a
      href="/contact-us"
      class="focus-ring hidden shrink-0 cursor-pointer items-center gap-1.5 rounded-lg bg-mb-accent px-5 py-2.5 text-sm font-semibold text-mb-surface transition-[background-color,transform] duration-200 hover:bg-mb-accent-hover motion-safe:hover:scale-[1.02] sm:inline-flex"
    >
      Get involved
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
      </svg>
    </a>

    <details class="mobile-nav-details group relative lg:hidden">
      <summary
        class="focus-ring flex h-11 min-h-11 w-11 min-w-11 cursor-pointer list-none items-center justify-center rounded-lg text-mb-accent transition-colors duration-200 marker:hidden hover:bg-white/8 [&::-webkit-details-marker]:hidden"
        aria-label="Open menu"
        aria-controls="mobile-nav-panel"
      >
        <span class="relative flex h-6 w-6 items-center justify-center">
          <svg
            class="absolute inset-0 m-auto h-6 w-6 group-open:hidden"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8h16M4 16h11" />
          </svg>
          <svg
            class="absolute inset-0 m-auto hidden h-6 w-6 group-open:block"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </span>
      </summary>
      <div
        id="mobile-nav-panel"
        class="-mx-4 overflow-hidden border-t border-white/10 bg-mb-surface/98 backdrop-blur-md sm:-mx-6"
      >
        <nav class="flex flex-col gap-0.5 px-4 py-4" aria-label="Mobile">
          {
            NAV_LINKS.map(({ to, end, label }) => (
              <a
                href={to}
                class:list={[
                  "focus-ring cursor-pointer rounded-md px-3 py-2 text-sm font-medium transition-colors duration-200",
                  isNavActive(currentPath, to, end)
                    ? "text-mb-accent"
                    : "text-mb-text-muted hover:text-mb-accent",
                ]}
                {...(isNavActive(currentPath, to, end)
                  ? { "aria-current": "page" as const }
                  : {})}
              >
                {label}
              </a>
            ))
          }
        </nav>
        <div class="flex items-center gap-3 border-t border-white/10 px-4 py-4">
          <a
            data-astro-prefetch
            href="/contact-us"
            class="focus-ring w-full cursor-pointer rounded-lg bg-mb-accent py-3 text-center text-sm font-semibold text-mb-surface transition-colors duration-200 hover:bg-mb-accent-hover"
          >
            Get involved
          </a>
        </div>
      </div>
    </details>
  </div>
</header>

<style is:global>
  .header-theme-hero .mb-brand-text {
    color: rgb(255 255 255);
  }
  .header-theme-hero .nav-desktop-link:not([aria-current="page"]) {
    color: rgb(255 255 255 / 0.8);
  }
  .header-theme-hero .nav-desktop-link:not([aria-current="page"]):hover {
    color: var(--color-mb-accent, #c79e47);
  }
  .header-theme-hero .mb-header-divider {
    background-color: rgb(255 255 255 / 0.18);
  }
  .header-theme-hero .mb-social-wrap {
    border-color: rgb(255 255 255 / 0.15);
  }

  .site-header:not(.header-theme-hero) .mb-brand-text {
    color: var(--color-mb-text-on-dark, #e8ecf4);
  }

  /* Home: scrolled — match solid sticky header (transparent only at top). */
  #site-header[data-home="true"][data-hero-top="false"] {
    border-bottom-color: rgb(199 158 71 / 0.2);
    background-color: rgb(20 29 46 / 0.98);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
  }
  #site-header[data-home="true"][data-hero-top="false"] .mb-brand-text {
    color: var(--color-mb-text-on-dark, #e8ecf4);
  }
  #site-header[data-home="true"][data-hero-top="false"]
    .nav-desktop-link:not([aria-current="page"]) {
    color: var(--color-mb-text-muted, #b8c4d9);
  }
  #site-header[data-home="true"][data-hero-top="false"]
    .nav-desktop-link:not([aria-current="page"]):hover {
    color: var(--color-mb-accent, #c79e47);
  }
  #site-header[data-home="true"][data-hero-top="false"] .mb-social-wrap {
    border-color: rgb(255 255 255 / 0.1);
  }
  #site-header[data-home="true"][data-hero-top="false"] .mb-social-wrap a {
    color: var(--color-mb-text-muted, #b8c4d9);
  }
  #site-header[data-home="true"][data-hero-top="false"] .mb-social-wrap a:hover {
    color: var(--color-mb-accent, #c79e47);
  }
</style>

<script is:inline>
  (function () {
    const THRESHOLD = 48;
    let detach = function () {};
    function bind() {
      detach();
      var header = document.getElementById("site-header");
      if (!header || header.getAttribute("data-home") !== "true") return;
      function sync() {
        header.setAttribute(
          "data-hero-top",
          window.scrollY < THRESHOLD ? "true" : "false",
        );
      }
      sync();
      window.addEventListener("scroll", sync, { passive: true });
      detach = function () {
        window.removeEventListener("scroll", sync);
      };
    }
    document.addEventListener("astro:page-load", bind);
    bind();
  })();
</script>