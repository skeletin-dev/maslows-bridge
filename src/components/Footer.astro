---
import { SITE } from "../site";

const FOOTER_NAV = [
  { to: "/", label: "Home" },
  { to: "/services", label: "Services" },
  { to: "/projects", label: "Projects" },
  { to: "/about", label: "About" },
  { to: "/history", label: "History" },
  { to: "/team", label: "Team" },
  { to: "/contact-us", label: "Contact" },
] as const;

const linkClass =
  "focus-ring rounded-md text-sm font-medium text-mb-text-on-dark/80 transition-colors duration-200 hover:text-mb-accent";

const year = new Date().getFullYear();
---

<footer class="relative overflow-hidden bg-mb-surface">
  <div
    class="footer-top-rule h-px w-full origin-left scale-x-0 bg-linear-to-r from-transparent via-mb-accent/50 to-transparent opacity-0"
    aria-hidden
  >
  </div>

  <div class="relative mx-auto max-w-6xl px-4 pb-10 pt-14 sm:px-6 sm:pb-12 sm:pt-16">
    <div class="grid gap-12 sm:grid-cols-2 lg:grid-cols-12 lg:gap-10">
      <div class="sm:col-span-2 lg:col-span-5">
        <a
          href="/"
          class="focus-ring inline-flex cursor-pointer items-center gap-3 rounded-lg p-1 outline-offset-4 transition-opacity duration-200 hover:opacity-85"
        >
          <img
            src={SITE.logoSrc}
            alt=""
            width={48}
            height={48}
            class="h-11 w-11 rounded-lg object-cover ring-1 ring-white/15"
          />
          <span class="font-sans text-lg font-semibold tracking-tight text-mb-text-on-dark">
            {SITE.name}
          </span>
        </a>

        <p class="mt-4 max-w-sm text-sm leading-relaxed text-mb-text-on-dark/70">
          {SITE.footerTagline}
        </p>

        <div class="mt-6 flex flex-wrap gap-2">
          <a
            href={SITE.social.facebook}
            target="_blank"
            rel="noopener noreferrer"
            class="focus-ring flex h-10 w-10 min-h-10 min-w-10 cursor-pointer items-center justify-center rounded-lg border border-white/12 bg-mb-surface-elevated/50 text-mb-text-muted transition-[border-color,background-color,color] duration-200 hover:border-mb-accent/40 hover:bg-mb-surface-elevated hover:text-mb-accent"
            aria-label="Facebook"
          >
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M24 12.073C24 5.405 18.627 0 12 0S0 5.405 0 12.073C0 18.1 4.388 23.094 10.125 24v-8.437H7.078v-3.473h3.047V9.428c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.473h-2.796v8.413C19.612 23.027 24 18.034 24 12.073z" />
            </svg>
          </a>
          <a
            href={SITE.social.instagram}
            target="_blank"
            rel="noopener noreferrer"
            class="focus-ring flex h-10 w-10 min-h-10 min-w-10 cursor-pointer items-center justify-center rounded-lg border border-white/12 bg-mb-surface-elevated/50 text-mb-text-muted transition-[border-color,background-color,color] duration-200 hover:border-mb-accent/40 hover:bg-mb-surface-elevated hover:text-mb-accent"
            aria-label="Instagram"
          >
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z" />
            </svg>
          </a>
          <a
            href={SITE.social.youtube}
            target="_blank"
            rel="noopener noreferrer"
            class="focus-ring flex h-10 w-10 min-h-10 min-w-10 cursor-pointer items-center justify-center rounded-lg border border-white/12 bg-mb-surface-elevated/50 text-mb-text-muted transition-[border-color,background-color,color] duration-200 hover:border-mb-accent/40 hover:bg-mb-surface-elevated hover:text-mb-accent"
            aria-label="YouTube"
          >
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" />
            </svg>
          </a>
        </div>
      </div>

      <div class="lg:col-span-3">
        <h2 class="text-xs font-semibold uppercase tracking-[0.2em] text-mb-accent">
          Explore
        </h2>
        <div class="mt-4 h-px bg-white/8" aria-hidden></div>
        <ul class="mt-5 flex flex-col gap-2.5" role="list">
          {
            FOOTER_NAV.map(({ to, label }) => (
              <li>
                <a href={to} class={linkClass}>
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="lg:col-span-4">
        <h2 class="text-xs font-semibold uppercase tracking-[0.2em] text-mb-accent">
          Connect
        </h2>
        <div class="mt-4 h-px bg-white/8" aria-hidden></div>
        <p class="mt-5 text-sm leading-relaxed text-mb-text-on-dark/70">
          Follow along or reach out—we read every message and respond personally.
        </p>
        <a
          href="/contact-us"
          class="focus-ring mt-5 inline-flex cursor-pointer items-center gap-2 rounded-lg bg-mb-accent px-5 py-2.5 text-sm font-semibold text-mb-surface transition-[background-color,transform] duration-200 hover:bg-mb-accent-hover motion-safe:hover:scale-[1.02]"
        >
          Contact us
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>
      </div>
    </div>

    <div
      class="mt-14 flex flex-col items-start gap-4 border-t border-white/10 pt-8 sm:flex-row sm:flex-wrap sm:items-center sm:justify-between"
    >
      <p class="text-sm text-mb-text-on-dark/55">
        © {year}
        {SITE.name}. All rights reserved.
      </p>
      <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
        <a
          href="/privacy-policy"
          class="focus-ring rounded-md text-mb-text-on-dark/70 transition-colors duration-200 hover:text-mb-accent"
        >
          Privacy Policy
        </a>
        <span class="hidden text-mb-text-on-dark/25 sm:inline" aria-hidden>·</span>
        <p class="text-xs text-mb-text-on-dark/35">Indianapolis, Indiana</p>
      </div>
    </div>
    <div class="mt-10 flex flex-col items-center gap-3 border-t border-white/10 pt-8">
      <div class="flex flex-wrap items-center justify-center gap-x-3 gap-y-2">
        <span class="text-[0.625rem] font-semibold uppercase tracking-[0.22em] text-mb-text-on-dark/45">
          Powered by
        </span>
        <a
          href="https://skeletin.dev"
          target="_blank"
          rel="noopener noreferrer"
          class="focus-ring group inline-flex shrink-0 rounded-sm outline-offset-4"
          aria-label="Skeletin — visit skeletin.dev"
        >
          <img
            src="/skeletin_black_logo.svg"
            alt=""
            width={326}
            height={55}
            class="h-5 w-auto transition-[filter] duration-200 ease-out group-hover:invert sm:h-6"
          />
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  @keyframes footer-rule-in {
    from {
      transform: scaleX(0);
      opacity: 0;
    }
    to {
      transform: scaleX(1);
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .footer-top-rule {
      animation: footer-rule-in 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .footer-top-rule {
      transform: scaleX(1);
      opacity: 1;
    }
  }
</style>
