---
import { SITE } from "../../site";
import { pillPrimary, pillSecondary } from "../pageLayout";
---

<section class="relative flex min-h-[min(85dvh,720px)] flex-col items-center justify-center overflow-hidden px-4 py-16 sm:py-24">
  <div
    class="absolute inset-0 bg-cover bg-center bg-no-repeat"
    style={`background-image: url(${SITE.heroBackgroundSrc})`}
    aria-hidden="true"
  ></div>
  <div class="absolute inset-0 bg-gradient-to-b from-mb-surface/90 via-mb-surface/85 to-mb-surface/95" aria-hidden="true"></div>
  <div class="relative z-[1] w-full max-w-lg">
    <div class="overflow-hidden rounded-2xl border border-white/15 bg-mb-surface/55 px-8 py-12 text-center shadow-[0_24px_80px_-24px_rgba(0,0,0,0.55)] backdrop-blur-xl sm:px-12 sm:py-14">
      <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-mb-accent/15 text-mb-accent ring-1 ring-white/10" aria-hidden="true">
        <svg class="h-9 w-9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 15L3 9m0 0l6-6M3 9h12a6 6 0 010 12h-3" />
        </svg>
      </div>
      <p class="mt-6 font-display text-5xl font-bold tabular-nums tracking-tight text-mb-accent sm:text-6xl">404</p>
      <h1 class="mt-3 font-display text-2xl font-bold text-mb-text-on-dark sm:text-3xl">Page not found</h1>
      <p class="mt-4 text-base leading-relaxed text-mb-text-muted">
        That link may be outdated, or the page may have moved. If you were looking for something
        specific, try home or contact us—we&apos;re glad to help.
      </p>
      <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:justify-center">
        <a href="/" class={pillPrimary}>Go to home</a>
        <a
          href="/contact-us"
          class:list={[pillSecondary, "border-white/25 bg-white/5 text-mb-text-on-dark hover:border-mb-accent/50 hover:bg-white/10"]}
        >
          Contact us
        </a>
      </div>
    </div>
  </div>
</section>
