---
import PageHero from "../PageHero.astro";
---

<div class="bg-mb-cream">
  <PageHero
    eyebrow="Get in touch"
    title="Contact Us"
    subtitle="Questions, partnerships, or need support? Reach out—we read every message."
    variant="atmosphere"
    size="large"
    class="pb-14 pt-14 sm:pb-16 sm:pt-20"
  />

  <section class="flex items-center justify-center px-4 pb-24 pt-10 sm:pb-32 sm:pt-14">
    <div class="w-full max-w-6xl">
      <div class="grid grid-cols-1 overflow-hidden rounded-2xl shadow-2xl lg:grid-cols-2">
        <div class="relative overflow-hidden bg-mb-surface p-8 text-white md:p-12">
          <div class="relative z-10">
            <div class="mb-8">
              <h2 class="font-display mb-4 text-4xl font-light text-mb-text-on-dark md:text-5xl">
                Contact
              </h2>
              <div class="contact-accent-rule h-1 w-20 bg-mb-accent" aria-hidden="true"></div>
            </div>
            <p class="mb-12 leading-relaxed text-white/80">
              We&apos;re here to help and answer any questions you might have. We look forward to
              hearing from you and making a difference together.
            </p>
            <div class="space-y-4">
              <div class="rounded-xl border border-white/10 bg-white/5 p-5 backdrop-blur-sm transition-colors duration-300 hover:bg-white/10">
                <div class="flex items-start gap-4">
                  <div class="relative shrink-0 rounded-lg bg-mb-accent/10 p-3 text-mb-accent">
                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
                    </svg>
                    <svg class="absolute -right-1 -top-1 h-4 w-4 text-mb-accent" viewBox="0 0 24 24" aria-hidden="true">
                      <path fill="currentColor" d="M12 2l1.5 4.5L18 8l-4.5 1.5L12 14l-1.5-4.5L6 8l4.5-1.5L12 2z" />
                    </svg>
                  </div>
                  <div class="flex-1">
                    <h3 class="mb-1 font-medium text-white">Email Us</h3>
                    <p class="text-sm text-white/70">info@maslowsbridge.org</p>
                    <p class="mt-1 text-xs text-white/50">We read every message</p>
                  </div>
                </div>
              </div>
              <div class="rounded-xl border border-white/10 bg-white/5 p-5 backdrop-blur-sm transition-colors duration-300 hover:bg-white/10">
                <div class="flex items-start gap-4">
                  <div class="relative shrink-0 rounded-lg bg-mb-accent/10 p-3 text-mb-accent">
                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
                    </svg>
                    <svg class="absolute -right-1 -top-1 h-4 w-4 text-mb-accent" viewBox="0 0 24 24" aria-hidden="true">
                      <circle cx="12" cy="8" r="3" fill="currentColor" />
                      <path fill="currentColor" d="M6 20c0-3.314 2.686-6 6-6s6 2.686 6 6H6z" />
                    </svg>
                  </div>
                  <div class="flex-1">
                    <h3 class="mb-1 font-medium text-white">Visit Us</h3>
                    <p class="text-sm text-white/70">5339 E 34th St</p>
                    <p class="mt-1 text-xs text-white/50">Indianapolis, IN 46218</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="bg-white p-8 md:p-12">
          <div class="mb-8">
            <h2 class="font-display mb-2 text-3xl font-light text-mb-ink">Send us a message</h2>
            <p class="text-mb-ink/60">
              Fill out the form below and we&apos;ll get back to you as soon as possible.
            </p>
          </div>

          <slot name="form" />

          <div class="mt-8 border-t border-mb-ink/10 pt-8">
            <p class="text-center text-sm text-mb-ink/60">
              By submitting this form, you acknowledge our
              <a href="/privacy-policy" class="focus-ring font-medium text-mb-accent underline-offset-2 hover:underline">
                Privacy Policy
              </a>.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>

<style>
  @keyframes contact-rule {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .contact-accent-rule {
      transform-origin: left;
      animation: contact-rule 1s ease-out 0.5s forwards;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .contact-accent-rule {
      transform: scaleX(1);
    }
  }
</style>
