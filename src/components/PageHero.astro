---
import { SITE } from "../site";

export type Props = {
  title: string;
  subtitle?: string;
  eyebrow?: string;
  variant?: "solid" | "gradient" | "image" | "atmosphere";
  imageUrl?: string;
  size?: "default" | "large";
  class?: string;
};

const {
  title,
  subtitle,
  eyebrow,
  variant = "solid",
  imageUrl,
  size = "default",
  class: className = "",
} = Astro.props;

const maxW = size === "large" ? "max-w-6xl" : "max-w-3xl";
const titleClass =
  size === "large"
    ? "font-display text-4xl font-bold tracking-[-0.025em] text-mb-text-on-dark sm:text-5xl lg:text-6xl"
    : "font-display text-3xl font-bold tracking-[-0.025em] text-mb-text-on-dark sm:text-4xl lg:text-5xl";

const isImage = variant === "image" && imageUrl;
const isAtmosphere = variant === "atmosphere";

const shellClass = [
  "relative overflow-hidden border-b border-white/10 px-4 sm:px-6",
  isAtmosphere
    ? "flex min-h-[min(44dvh,32rem)] flex-col justify-center py-16 sm:min-h-[min(50dvh,38rem)] sm:py-20"
    : "py-14 sm:py-20",
  !isImage && !isAtmosphere && variant === "gradient"
    ? "bg-mb-surface"
    : !isImage && !isAtmosphere
      ? "bg-mb-surface"
      : "",
  className,
]
  .filter(Boolean)
  .join(" ");
---

<div class={shellClass}>
  {
    isImage ? (
      <>
        <div
          class="absolute inset-0 bg-cover bg-center bg-no-repeat"
          style={`background-image: url(${imageUrl})`}
        />
        <div
          class="absolute inset-0 bg-linear-to-b from-mb-surface/88 via-mb-surface/72 to-mb-surface/95"
          aria-hidden
        />
      </>
    ) : isAtmosphere ? (
      <>
        <div
          class="absolute inset-0 bg-cover bg-center bg-no-repeat"
          style={`background-image: url(${SITE.heroBackgroundSrc})`}
        />
        <div
          class="absolute inset-0 bg-linear-to-b from-mb-surface/82 via-mb-surface-elevated/38 to-mb-surface/[0.96]"
          aria-hidden
        />
        <div
          class="pointer-events-none absolute inset-0 bg-linear-to-t from-mb-surface via-mb-surface/50 to-mb-surface/35"
          aria-hidden
        />
        <div
          class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_55%_45%_at_85%_15%,rgba(199,158,71,0.09),transparent)]"
          aria-hidden
        />
        <div
          class="hero-orb-a pointer-events-none absolute right-[14%] top-[18%] h-44 w-44 rounded-full bg-mb-accent/12 blur-3xl"
          aria-hidden
        />
        <div
          class="hero-orb-b pointer-events-none absolute bottom-[12%] left-[8%] h-32 w-32 rounded-full bg-mb-hope/20 blur-2xl"
          aria-hidden
        />
        <div
          class="hero-orb-c pointer-events-none absolute bottom-[30%] right-[4%] h-20 w-20 rounded-full bg-mb-accent/10 blur-xl"
          aria-hidden
        />
      </>
    ) : variant === "gradient" ? (
      <>
        <div
          class="pointer-events-none absolute inset-0 bg-linear-to-br from-mb-surface-elevated/45 via-transparent to-mb-surface"
          aria-hidden
        />
        <div
          class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_80%_55%_at_50%_-15%,rgba(199,158,71,0.14),transparent)]"
          aria-hidden
        />
        <div
          class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_50%_40%_at_100%_30%,rgba(91,138,120,0.09),transparent)]"
          aria-hidden
        />
      </>
    ) : null
  }

  <div class={`relative z-[1] mx-auto w-full ${maxW}`}>
    {
      eyebrow ? (
        <p class="inline-flex items-center gap-2 rounded-md border border-mb-accent/30 bg-mb-accent/10 px-3 py-1.5 text-xs font-semibold uppercase tracking-[0.2em] text-mb-accent">
          {eyebrow}
        </p>
      ) : null
    }
    <h1 class:list={[titleClass, eyebrow ? "mt-5" : ""]}>{title}</h1>
    {
      subtitle ? (
        <p
          class:list={[
            "mt-4 font-sans leading-relaxed text-mb-text-on-dark/80",
            size === "large"
              ? "max-w-2xl text-lg sm:text-xl"
              : "max-w-xl text-base sm:text-lg",
          ]}
        >
          {subtitle}
        </p>
      ) : null
    }
  </div>
</div>

<style>
  @keyframes hero-orb-float-a {
    0%,
    100% {
      transform: translateY(0) scale(1);
      opacity: 0.45;
    }
    50% {
      transform: translateY(-18px) scale(1.06);
      opacity: 0.85;
    }
  }
  @keyframes hero-orb-float-b {
    0%,
    100% {
      transform: translateY(0);
      opacity: 0.35;
    }
    50% {
      transform: translateY(14px);
      opacity: 0.65;
    }
  }
  @keyframes hero-orb-float-c {
    0%,
    100% {
      transform: translate(0, 0);
      opacity: 0.25;
    }
    50% {
      transform: translate(6px, -10px);
      opacity: 0.5;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-orb-a {
      animation: hero-orb-float-a 6s ease-in-out infinite;
    }
    .hero-orb-b {
      animation: hero-orb-float-b 7.5s ease-in-out infinite 1.2s;
    }
    .hero-orb-c {
      animation: hero-orb-float-c 5s ease-in-out infinite 2.5s;
    }
  }
</style>
