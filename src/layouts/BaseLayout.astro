---
import { ClientRouter } from "astro:transitions";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../index.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Maslow's Bridge | Empowering the homeless community",
  description = "Maslow's Bridge Indy supports the homeless community with job training and everyday resources to help neighbors reintegrate with dignity.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,400..700;1,14..32,400..700&family=Newsreader:ital,opsz,wght@0,6..72,400..800;1,6..72,400..800&display=swap"
      rel="stylesheet"
    />
    <link rel="preload" as="image" href="/indianapolis.jpg" />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class="flex min-h-dvh flex-col bg-mb-cream text-mb-ink">
    <Header />
    <main class="flex flex-1 flex-col">
      <slot />
    </main>
    <Footer />
  </body>
</html>
